          75% { transform: translate(45%, 45%) scale(0.99); }
          100% { transform: translate(50%, 50%) scale(1); }
        }

        @keyframes iconBounce {
          0%, 100% { transform: translateY(0); }
          50% { transform: translateY(-5px); }
