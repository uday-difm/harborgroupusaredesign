import { useParallax } from '@/comman/motion/useParallax';
import { HarborArc } from '@/comman/HarborArc';
import { SectionGlow } from '@/comman/SectionGlow';

const sectionReveal = {
  hidden: {},
  show: {
    transition: { staggerChildren: 0.05, delayChildren: 0.1 }
  }
};

const cardVariant = {
  hidden: { opacity: 0, y: 20 },
